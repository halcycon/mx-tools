{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts", "@types/node"],
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@engine/*": ["./worker/checks/*"]
    }
  },
  "include": ["worker/**/*.ts", "web/src/**/*.tsx", "web/src/**/*.ts", "vite.config.ts"]
}
