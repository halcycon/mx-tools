{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mx-tools",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		// "true" also allows http://localhost:1313 (Hugo dev) to call /api/v1/health-check
		"HEALTH_CHECK_ALLOW_DEV_ORIGINS": "false"
	},
	"ratelimits": [
		{
			// Per hashed client IP, per Cloudflare location (approximate). Period must be 10 or 60.
			"name": "HEALTH_CHECK_RATE_LIMITER",
			"namespace_id": "4101",
			"simple": { "limit": 3, "period": 60 }
		}
	],
	"preview_urls": true,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
