# Copy into the project's .env (Arcane: project → Environment Configuration). Never commit real values.

# Bearer token for the agent's interactive endpoints (/api/lookup etc.). openssl rand -hex 24
MX_AGENT_TOKEN=

# Required for POST /api/v1/probe. Same value as the Worker secret AGENT_HMAC_SECRET. openssl rand -hex 32
MX_AGENT_HMAC_SECRET=

# Spamhaus Data Query Service key (optional but recommended). Stays on this server.
SPAMHAUS_DQS_KEY=

# Cloudflare Zero Trust → Networks → Tunnels → (tunnel) → install connector → copy the token.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional image pins
# AGENT_IMAGE_TAG=latest
# UNBOUND_IMAGE_TAG=latest
# CLOUDFLARED_IMAGE_TAG=latest
